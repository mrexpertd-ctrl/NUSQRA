{
  "name": "nusqra-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY", "SUPREME_ADMIN_EMAIL"]
  },
  "vars": {
    "SUPABASE_URL": "https://oybodlncqgerucwwkqvp.supabase.co",
    "SUPABASE_ANON_KEY": "SET_WITH_WRANGLER_SECRET"
  }
}
